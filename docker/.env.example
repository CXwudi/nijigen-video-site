# Copy this file to docker/.env before running Docker commands.

COMPOSE_PROJECT_NAME=nijigen-video-site

POSTGRES_DB=nijigen_video_site
POSTGRES_USER=nijigen
POSTGRES_PASSWORD=nijigen
POSTGRES_HOST_PORT=5432

REDIS_HOST_PORT=6379

API_APPLICATION_NAME=apps-api
API_HTTP_PORT=8080
FRONTEND_HTTP_PORT=5173
WEB_PNPM_IMAGE=nijigen-video-site-web-pnpm:local

# Direct Compose needs these values; mise tasks detect the host user.
HOST_UID=1000
HOST_GID=1000
# HOST_GRADLE_USER_HOME=/home/you/.gradle
